[
  {
    "rule": "a live line carries its Next",
    "where": {
      "type": "relation",
      "subtype": [
        "in talks",
        "agreed",
        "running",
        "paused"
      ]
    },
    "require": {
      "field": "description",
      "matches": "(?im)^next\\b"
    }
  },
  {
    "rule": "every work item carries the room's mark",
    "where": {
      "type": "relation",
      "supertype": "Work item"
    },
    "require": {
      "field": "x_room_of",
      "present": true
    }
  },
  {
    "rule": "every report carries the room's mark",
    "where": {
      "type": "narrative",
      "supertype": "Report"
    },
    "require": {
      "field": "x_room_of",
      "present": true
    }
  }
]
